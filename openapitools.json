{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "generator-cli": {
    "useDocker": true,
    "version": "6.6.0",
    "generators": {
      "ambulance-wl": {
        "generatorName": "typescript-fetch",
        "glob": "api/vykon.openapi.yaml",
        "output": "#{cwd}/src/api/vykon",
        "additionalProperties": {
          "supportsES6": "true",
          "withInterfaces": true
        }
      },
      "ambulance-assignment": {
        "generatorName": "typescript-fetch",
        "glob": "api/assignment.openapi.yaml",
        "output": "#{cwd}/src/api/assignment",
        "additionalProperties": {
          "supportsES6": "true",
          "withInterfaces": true
        }
      },
      "ambulance-employee": {
        "generatorName": "typescript-fetch",
        "glob": "api/employee.openapi.yaml",
        "output": "#{cwd}/src/api/employee",
        "additionalProperties": {
          "supportsES6": "true",
          "withInterfaces": true
        }
      }
    }
  }
}
